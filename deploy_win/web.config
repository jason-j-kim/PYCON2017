<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS 앞단 설정 — 정책 아이디어 평가

  이 파일을 IIS 사이트의 실체 경로(예: C:\inetpub\policy-eval)에 두면
  IIS 가 127.0.0.1:8000 의 파이썬 서버로 요청을 넘긴다.

  먼저 IIS 에 모듈 두 개가 있어야 한다. 없으면 규칙이 무시되고 404 가 난다.
      URL Rewrite                  https://www.iis.net/downloads/microsoft/url-rewrite
      Application Request Routing  https://www.iis.net/downloads/microsoft/application-request-routing

  ARR 을 설치한 뒤 IIS 관리자에서 한 번 켜야 한다:
      서버 노드 → Application Request Routing Cache → Server Proxy Settings
      → Enable proxy 체크 → 적용

  인증서는 IIS 관리자에서 사이트 바인딩(https, 443)에 붙인다.
  방문자가 이 화면에 자기 API 키를 붙여넣으므로 http 로 열지 않는다.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- 기록 화면은 밖에서 아예 닿지 못하게 한다.
             앱 안에도 잠금장치가 있지만(_require_local) 겹으로 둔다.
             sessions.db 에는 여러 사람의 문답이 함께 쌓이므로 실수 한 번으로
             남의 대화가 나가면 되돌릴 수 없다.
             운영자는 서버에 원격 데스크톱으로 들어가
             http://localhost:8000/records 를 연다. -->
        <rule name="BlockRecords" stopProcessing="true">
          <match url="^(records|api/records)(/.*)?$" />
          <action type="CustomResponse" statusCode="404"
                  statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- 평문으로 들어온 것은 https 로 보낸다. 인증서를 붙인 뒤에 켠다.
             인증서 없이 켜면 접속이 아예 안 되므로 처음에는 주석으로 둔다.
        <rule name="ForceHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>
        -->

        <!-- 나머지는 파이썬 서버로 넘긴다 -->
        <rule name="ToUvicorn" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>

      </rules>
    </rewrite>

    <!-- Claude 호출이 오래 걸린다. 문답 한 턴에 30초를 넘기는 일도 있어
         기본값으로는 끊긴다. 넉넉히 5분. -->
    <proxy timeout="00:05:00" preserveHostHeader="true"
           reverseRewriteHostInResponseHeaders="false" />

    <security>
      <requestFiltering>
        <!-- 붙여넣는 문답과 되불러오는 파일이 있어 넉넉히 (20MB) -->
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

    <!-- 서버 안의 오류를 방문자 화면에 그대로 보이지 않게 한다 -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />

  </system.webServer>
</configuration>
